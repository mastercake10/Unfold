#version 450
#extension GL_GOOGLE_include_directive : require
// one pass of a separable Gaussian blur, BORDER_REFLECT_101; 256 pixels of a row per workgroup
// (horizontal: the row segment and its halo in shared memory). Source/destination bindings and
// direction are specialisation constants, so the binding switch folds away.
layout(local_size_x = 256) in;
#include "common.glsl"
layout(constant_id = 0) const int SRCB = 0;
layout(constant_id = 1) const int DSTB = 6;
layout(constant_id = 2) const bool VERTICAL = false;
layout(push_constant) uniform PC { int w, h, k, r; } pc;  // k: kernel offset in IO

const int MAXR = 16;
shared float line[256 + 2 * MAXR];
shared float wk[2 * MAXR + 1];

int reflect101(int p, int n) {
    if (n == 1) return 0;
    while (p < 0 || p >= n) {
        if (p < 0) p = -p;
        if (p >= n) p = 2 * n - 2 - p;
    }
    return p;
}

void main() {
    int t = int(gl_LocalInvocationID.x);
    const int r = pc.r, n = 2 * pc.r;
    if (t <= n) wk[t] = iof(KERN + pc.k + t);
    if (VERTICAL) {
        barrier();
        // a run of 256 pixels of one row; neighbouring threads read neighbouring pixels of rows y-r..y+r
        int x = int(gl_WorkGroupID.x) * 256 + t, y = int(gl_WorkGroupID.y);
        if (x >= pc.w || y >= pc.h) return;
        float s = 0.0;
        if (y >= r && y + r < pc.h) {
            int i = (y - r) * pc.w + x;
            for (int j = 0; j <= n; j++, i += pc.w) s += wk[j] * rd(SRCB, i);
        } else {
            for (int j = 0; j <= n; j++) s += wk[j] * rd(SRCB, reflect101(y + j - r, pc.h) * pc.w + x);
        }
        wr(DSTB, y * pc.w + x, s);
        return;
    }
    int ln = int(gl_WorkGroupID.y);
    int base = int(gl_WorkGroupID.x) * 256;
    if (ln < pc.h) {
        int row = ln * pc.w;
        for (int i = t; i < 256 + n; i += 256) {
            int p = base + i - r;
            line[i] = rd(SRCB, row + (p >= 0 && p < pc.w ? p : reflect101(p, pc.w)));
        }
    }
    barrier();
    int p = base + t;
    if (ln >= pc.h || p >= pc.w) return;
    float s = 0.0;
    for (int j = 0; j <= n; j++) s += wk[j] * line[t + j];
    wr(DSTB, ln * pc.w + p, s);
}
